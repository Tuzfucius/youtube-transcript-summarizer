{
  "name": "video-summarizer",
  "version": "3.10.0",
  "description": "Video text extractor and summarizer focused on YouTube and Bilibili.",
  "entry_point": "video_summarizer.py",
  "cli_command": "python -m video_summarizer",
  "api_style": "openai-compatible",
  "capabilities": [
    "summarize_video",
    "extract_content",
    "clean_danmaku",
    "export_subtitle"
  ],
  "platforms": [
    "youtube",
    "bilibili"
  ],
  "output_formats": [
    "brief",
    "detailed",
    "timestamp",
    "sentiment",
    "trend"
  ],
  "requirements": [
    "requests>=2.31.0",
    "yt-dlp>=2024.0.0",
    "youtube-transcript-api>=0.6.0"
  ]
}
